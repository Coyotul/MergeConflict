# RAG settings
RAG_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag
RAG_TEST_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag_test
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# cpu works everywhere; use cuda with an NVIDIA GPU and the CUDA build of torch (docs/runbooks/rag-local.md)
RAG_EMBEDDING_DEVICE=cpu
RAG_CANDIDATE_K=30
RAG_RRF_K=20
RAG_KEYWORD_WEIGHT=0.3
RAG_DENSE_FLOOR=0.75
RAG_DENSE_MARGIN_WEIGHT=3.0
RAG_DENSE_MARGIN_RANK=10
RAG_AUTHORITY_WEIGHTS={"high": 1.0, "medium": 1.0, "low": 1.0}

# Orchestrator settings
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
ORCHESTRATOR_MODEL=openai/gpt-oss-120b
ORCHESTRATOR_TEMPERATURE=0.2
ORCHESTRATOR_REQUEST_TIMEOUT_S=60.0
ORCHESTRATOR_JSON_MODE=true
ORCHESTRATOR_MAX_STEPS=4
ORCHESTRATOR_HISTORY_WINDOW=30
ORCHESTRATOR_SESSION_STORE=file
ORCHESTRATOR_SESSIONS_DIR=data/local/sessions
ORCHESTRATOR_UPLOADS_DIR=data/local/uploads
ORCHESTRATOR_MAX_UPLOAD_BYTES=10485760
ORCHESTRATOR_CONFIG_DIR=config/orchestrator
ORCHESTRATOR_RETRIEVAL=stub
ORCHESTRATOR_DATABASE_URL=postgresql://rag:rag@127.0.0.1:5433/rag
ORCHESTRATOR_TRACE=file
ORCHESTRATOR_TRACES_DIR=data/local/traces
ORCHESTRATOR_CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3000,http://localhost:3001

# Conversation evaluation (scripts/eval/run_scenarios.py, docs/runbooks/conversation-eval.md)
# Simulated customer model; empty = the agent's ORCHESTRATOR_MODEL (temperature 0.7).
EVAL_CUSTOMER_MODEL=
# Wording judge (temperature 0); empty = deepseek-ai/DeepSeek-V3-0324, a different family from the agent.
EVAL_JUDGE_MODEL=
